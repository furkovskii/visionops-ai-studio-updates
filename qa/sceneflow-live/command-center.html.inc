<style>
/* VisionOps AI brand: graphite / porcelain / oxide / signal / stone. Scoped: original operational tools preserved. */
.vo-command{--vc-ink:#20201C;--vc-paper:#F2EEE5;--vc-signal:#D3DD62;--vc-oxide:#BD482D;--vc-stone:#6B6959;box-sizing:border-box;isolation:isolate;color:var(--vc-paper);background:var(--vc-ink);border:1px solid #6B6959;border-radius:20px;overflow:hidden;margin:15px 0 24px;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;box-shadow:0 22px 65px #17171135}
.vo-command *{box-sizing:border-box}.vo-command a{color:inherit;text-decoration:none}.vo-command button,.vo-command a{font:inherit}.vo-command button{cursor:pointer}.vo-command :is(button,a):focus-visible{outline:2px solid var(--vc-signal);outline-offset:4px}
.vc-shell{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:610px}
.vc-aside{background:#191915;border-right:1px solid #6B695955;padding:23px 14px;display:flex;flex-direction:column;gap:23px}
.vc-wordmark{display:flex;align-items:center;gap:9px;font-weight:850;letter-spacing:-.04em;font-size:19px;color:#F2EEE5}
.vc-symbol{color:var(--vc-signal);font-size:27px;line-height:1}.vc-tag{display:block;font-size:9px;color:#b3b09c;letter-spacing:.2em;font-weight:700;margin:6px 13px 0}
.vc-nav{display:grid;gap:6px}.vc-nav button{border:1px solid transparent;background:none;color:#D6D0C5;border-radius:10px;display:flex;gap:10px;align-items:center;text-align:left;padding:13px 12px;font-size:13px;font-weight:650;min-height:44px}
.vc-nav button[aria-selected=true]{background:var(--vc-signal);color:#20201C}.vc-nav button:not([aria-selected=true]):hover{background:#35332b}
.vc-aside .vc-help{margin-top:auto;border-top:1px solid #6B69595c;padding:19px 8px 0;font-size:11px;line-height:1.6;color:#bdb5a4}
.vc-main{min-width:0;background:#24231e}.vc-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:64px;padding:14px 24px;border-bottom:1px solid #6B695953;font-size:10px;letter-spacing:.12em;font-weight:800;color:#d1cabc}.vc-status-pill{display:inline-flex;gap:6px;align-items:center;white-space:nowrap;padding:8px 10px;background:#3d3b30;border-radius:30px;color:var(--vc-signal);letter-spacing:0;font-weight:750}.vc-status-pill i{width:7px;height:7px;border-radius:50%;background:var(--vc-signal)}
.vc-view{padding:25px}.vc-view[hidden]{display:none}.vc-hero{position:relative;isolation:isolate;min-height:260px;border:1px solid #6B6959;border-radius:13px;overflow:hidden;padding:30px;display:flex;align-items:center;background:#30261e}
.vc-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.vc-hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#20201cf9 0%,#20201cd8 42%,#20201c40 100%)}
.vc-hero h2{margin:11px 0 13px;color:#F2EEE5;font-size:clamp(32px,3.4vw,54px);letter-spacing:-.06em;line-height:1.08;font-weight:830}.vc-hero h2 em{font-style:normal;color:var(--vc-signal)}.vc-hero p{max-width:480px;color:#ddd5c8;font-size:13px;line-height:1.65}.vc-eyebrow{color:var(--vc-signal);font-size:10px;font-weight:800;letter-spacing:.19em}.vc-hero small{position:absolute;right:15px;bottom:13px;color:#f2eee5a6;font-size:10px}
.vc-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0 0}.vc-summary article{background:#302e27;border:1px solid #6B69596b;border-radius:12px;padding:17px;min-width:0}.vc-summary small{font-size:11px;color:#c6beb0;display:block}.vc-summary strong{display:block;color:#F2EEE5;font-size:clamp(18px,2.3vw,28px);margin:10px 0 2px;line-height:1.3}.vc-summary span{display:block;color:#aca595;font-size:10px;line-height:1.5}
.vc-work{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}.vc-work a,.vc-action{min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#343128;color:#F2EEE5;border:1px solid #6B6959;border-radius:12px;padding:18px;text-align:left;text-decoration:none;font-weight:750;font-size:13px}.vc-work a:hover,.vc-action:hover{border-color:#D3DD62}.vc-work a span{display:block;color:#c6bdab;font-size:11px;font-weight:400;margin-top:6px;line-height:1.5}.vc-work b{color:#D3DD62;font-size:18px}
.vc-subhead{font-size:24px;font-weight:790;letter-spacing:-.045em;margin:2px 0 9px;color:#F2EEE5}.vc-helptext{font-size:13px;color:#c3bbae;line-height:1.75;max-width:720px;margin:0 0 20px}.vc-camera-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin:15px 0}.vc-camera-list>div{padding:17px;min-width:0;border:1px solid #6B695966;border-radius:11px;background:#302e27}.vc-camera-list strong{display:block;font-size:13px;overflow-wrap:anywhere}.vc-camera-list small{display:block;font-size:11px;color:#bbb1a3;margin-top:7px}.vc-empty{padding:19px;background:#302e27;border:1px dashed #6B6959;border-radius:11px;font-size:12px;color:#cac1b1}
.vc-action{min-height:45px;width:fit-content;color:#20201C!important;background:#D3DD62;border-color:#D3DD62;padding:12px 16px;margin:16px 0 0}.vc-action:hover{background:#edf58c}.vc-note{margin-top:18px;border-top:1px solid #6B69597a;padding-top:14px;font-size:11px;color:#aaa497;line-height:1.6}
/* Make existing SceneFlow/TruthMeter panels visually coherent; do not interfere with their data controls */
#vo-scene{background:#28271f!important;border-color:#6B6959!important;color:#F2EEE5!important}#vo-scene :is(h3,.vo-scene-eyebrow){color:#D3DD62!important}#vo-scene .vo-scene-steps,#vo-scene .vo-scene-side{background:#343129!important;border-color:#6B6959!important}#vo-scene .vo-scene-flow>div{background:#24231e!important;border-color:#6B6959!important}#vo-scene .vo-scene-flow>div:nth-child(2){background:#D3DD62!important}#vo-scene .vo-scene-flow>div:nth-child(2) :is(b,strong,span){color:#20201C!important}
#vo-sf-live{border-color:#6B6959!important}#vo-sf-live :is(h4,.vo-sf-evidence strong){color:#D3DD62!important}#vo-sf-live .vo-sf-primary{background:#D3DD62!important;color:#20201C!important;border-color:#D3DD62!important}
@media(max-width:900px){.vc-shell{grid-template-columns:175px minmax(0,1fr)}.vc-hero{min-height:230px;padding:22px}.vc-view{padding:16px}.vc-summary{gap:8px}.vc-summary article{padding:12px}.vc-work{gap:9px}}
@media(max-width:680px){.vc-shell{grid-template-columns:1fr}.vc-aside{padding:14px;gap:8px;border-right:0;border-bottom:1px solid #6B6959}.vc-aside .vc-help,.vc-tag{display:none}.vc-wordmark{font-size:17px}.vc-nav{display:flex;overflow:auto}.vc-nav button{flex:none;white-space:nowrap;padding:9px 12px}.vc-toolbar{min-height:51px;padding:11px 14px;flex-wrap:wrap}.vc-view{padding:13px}.vc-hero{min-height:260px;padding:17px}.vc-hero h2{font-size:37px}.vc-summary{grid-template-columns:1fr}.vc-work{grid-template-columns:1fr}.vc-camera-list{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.vo-command *{scroll-behavior:auto!important;transition:none!important}}
</style>
