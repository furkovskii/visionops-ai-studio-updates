function smartWrite(values,zones){const list=byId('vo-smart-list');if(!list)return;list.replaceChildren();list.dataset.zones=JSON.stringify(zones);for(const r of values)smartAdd(r);}
function smartAdd(r={name:'',kind:'count',zone:'',duration:60,threshold:1,cooldown:300,enabled:true}){const list=byId('vo-smart-list');if(!list||list.children.length>=8)return;const row=document.createElement('div');row.style.cssText='display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:8px;border:1px solid var(--stroke,#667);padding:10px;border-radius:10px';const zones=JSON.parse(list.dataset.zones||'[]');function field(label,key,kind,value,opts=[]){const l=document.createElement('label');l.textContent=label;const el=document.createElement(kind==='select'?'select':'input');el.dataset.smart=key;if(kind==='select')for(const [v,t] of opts)el.add(new Option(t,v));else{el.type=kind;if(kind==='number'){el.step='1';el.min=key==='threshold'?'1':key==='duration'?'10':'60';el.max=key==='threshold'?'100':key==='duration'?'43200':'86400';el.required=true;}if(kind==='text'){el.maxLength=40;el.required=true;}}if(kind==='checkbox')el.checked=value;else el.value=value;el.addEventListener('change',()=>{ruleDirty=true;sync();});el.addEventListener('input',()=>{ruleDirty=true;});l.append(el);row.append(l);return el;}field('Senaryo adı','name','text',r.name);const kind=field('Eğer','kind','select',r.kind,[['count','Algılama sayısı eşiği'],['absence','Alanda algılama yok'],['dwell','Alan kalış eşiği'],['entry','Alana giriş adayı']]);const zone=field('Alan','zone','select',r.zone,[['','Alan seç'],...zones.map(z=>[z,z])]);const duration=field('Süre (sn)','duration','number',r.duration);const threshold=field('En az algılama','threshold','number',r.threshold);field('Tekrar bekleme (sn)','cooldown','number',r.cooldown);field('Etkin','enabled','checkbox',r.enabled);const btn=document.createElement('button');btn.type='button';btn.className='btn';btn.textContent='Kuralı kaldır';btn.onclick=()=>{row.remove();ruleDirty=true;};row.append(btn);function sync(){zone.parentElement.hidden=kind.value==='count';threshold.parentElement.hidden=kind.value!=='count';duration.parentElement.hidden=kind.value==='entry';}sync();list.append(row);}
function smartRead(){const list=byId('vo-smart-list');if(!list)return [];return Array.from(list.children).map(row=>{const v={};for(const el of row.querySelectorAll('[data-smart]')){if(!el.checkValidity())throw Error('Senaryo alanlarını kontrol edin.');v[el.dataset.smart]=el.type==='checkbox'?el.checked:el.type==='number'?Number(el.value):el.value;}if(v.kind!=='count'&&!v.zone)throw Error('Senaryo için alan seçin.');return v;});}
byId('vo-smart-add').onclick=()=>{if(ruleLoaded&&ruleId&&!ruleBusy){smartAdd();ruleDirty=true;}};
