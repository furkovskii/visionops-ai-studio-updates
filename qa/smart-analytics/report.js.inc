function renderSmartReport(data){const s=data?.smart,tr=byId('vo-smart-trend');const t=s?.trend;tr.replaceChildren();if(!t||t.status==='insufficient'){tr.textContent=t?.reason||'Yeterli kayıt bekleniyor.';}else{const b=document.createElement('strong'),p=document.createElement('p'),q=document.createElement('small');b.textContent=({higher:'Alışılmış örnek ortalamasından yüksek',lower:'Alışılmış örnek ortalamasından düşük',stable:'Belirlenen değişim eşiği aşılmadı'})[t.status]||'Ölçüm';p.textContent=String(t.hour).padStart(2,'0')+':00 — '+t.current+' algılama/örnek; geçmiş medyan '+t.baseline+' · '+(t.percent===null?'Yüzde hesaplanamaz':(t.percent>0?'+':'')+t.percent+'%')+' · '+t.baseline_days+'/7 geçmiş gün, '+t.current_samples+' örnek';q.textContent=t.reason;tr.append(b,p,q);}const heat=s?.heatmaps?.[byId('vo-heat-period').value],cv=byId('wall-heat'),ctx=cv.getContext('2d');ctx.clearRect(0,0,cv.width,cv.height);ctx.fillStyle='#24252b';ctx.fillRect(0,0,cv.width,cv.height);const w=cv.width/12,h=cv.height/8,max=Math.max(0,...(heat?.rates??[]).filter(v=>v!==null));for(let i=0;i<96;i++){const rate=heat?.rates?.[i];ctx.fillStyle=rate==null?'#42434a':rate===0?'#343b4a':`hsl(${48-43*rate/(max||1)},85%,${32+26*rate/(max||1)}%)`;ctx.fillRect(i%12*w+1,Math.floor(i/12)*h+1,w-2,h-2);}byId('wall-heat-label').textContent=!heat?.samples?'Ölçüm yok · sıfır algılama olarak yorumlanmaz.':heat.covered_days+'/'+heat.days+' kayıtlı gün · '+heat.samples.toLocaleString('tr-TR')+' analiz örneği · en yüksek hücre '+max.toFixed(3)+' algılama/örnek. Renkler seçili döneme göre göreceli; kamera koordinatları, gerçek metrekare veya tekil kişi/hayvan değildir.';}
byId('vo-heat-period').onchange=()=>renderSmartReport(latestReport);
